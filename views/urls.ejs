<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <div class="page-section">
    <div class="page-header">
      <h1 class="page-title"><%= pageTitle %></h1>
      <% if (urls && urls.length > 0) { %>
        <p class="page-meta"><%= urls.length %> <%= urls.length === 1 ? 'URL' : 'URLs' %> encurtada<%= urls.length === 1 ? '' : 's' %></p>
      <% } %>
      <a href="/" class="back-link">← Voltar para página inicial</a>
    </div>

    <% if (urls && urls.length > 0) { %>
      <div class="urls-table-wrap">
        <table class="url-table">
          <thead>
            <tr>
              <th>URL original</th>
              <th>Link curto</th>
              <th>Código</th>
              <th>Clicks</th>
              <th>Criada em</th>
            </tr>
          </thead>
          <tbody>
            <% urls.forEach(function(url) { %>
              <tr>
                <td class="original-url" title="<%= url.originalUrl %>"><%= url.originalUrl %></td>
                <td class="short-url-cell">
                  <a href="/<%= url.shortCode %>" target="_blank" rel="noopener"><%= url.shortCode %></a>
                </td>
                <td><code class="url-code"><%= url.shortCode %></code></td>
                <td class="url-clicks"><%= url.clicks %></td>
                <td class="url-date"><%= new Date(url.createdAt).toLocaleString('pt-BR') %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="no-urls">
        <h3>Nenhuma URL encurtada ainda</h3>
        <p>Encurte sua primeira URL na <a href="/">página inicial</a>.</p>
      </div>
    <% } %>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
